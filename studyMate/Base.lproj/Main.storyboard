                                                                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                                                    <color key="textColor" systemColor="secondaryLabelColor"/>
                                                                    <nil key="highlightedColor"/>
                                                                </label>
                                                            </subviews>
                                                        </stackView>
                                                    </subviews>
                                                    <color key="backgroundColor" systemColor="secondarySystemGroupedBackgroundColor"/>
                                                    <constraints>
                                                        <constraint firstItem="btn-today-check" firstAttribute="leading" secondItem="v-today-card" secondAttribute="leading" constant="14" id="c-today-btn-l"/>
                                                        <constraint firstItem="btn-today-check" firstAttribute="centerY" secondItem="v-today-card" secondAttribute="centerY" id="c-today-btn-y"/>
                                                        <constraint firstItem="sv-today-task" firstAttribute="leading" secondItem="btn-today-check" secondAttribute="trailing" constant="12" id="c-today-sv-l"/>
                                                        <constraint firstAttribute="trailing" secondItem="sv-today-task" secondAttribute="trailing" constant="14" id="c-today-sv-r"/>
